{
  "name": "@shenjack/dsh-cot-summary",
  "version": "0.1.0",
  "description": "在主模型 thinking 时流式生成并持久化 Summary-CoT 的 DSH 插件",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./projection": "./src/projection-types.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-retry": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/schemastery": "*",
    "zod": "*"
  }
}
