{
  "name": "@shenjack/dsh-client-cot-summary-overlay",
  "version": "0.1.0",
  "description": "使用 DSH 可选补丁接管 Think 行的 Summary-CoT 浏览器插件",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "immediately": false
    }
  },
  "files": [
    "src",
    "lib/client.js",
    "README.md"
  ],
  "dependencies": {
    "@shenjack/dsh-cot-summary": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.2",
    "react": "^18.2.0"
  }
}
