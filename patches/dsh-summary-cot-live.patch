new file mode 100644
index 00000000..05720c31
--- /dev/null
+++ b/packages/client/ui-conversation/tests/assistant-reasoning-chain.client.spec.tsx
@@ -0,0 +1,66 @@
+// @vitest-environment jsdom
+import { describe, expect, it } from 'vitest'
+import { render } from '@testing-library/react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import { AssistantMarkdown, type AssistantMarkdownProps } from '../src/client/chat/AssistantMarkdown.tsx'
+import type { ReasoningBlockOwnerProps } from '../src/client/contract/slots.ts'
+import { zh } from '../src/client/locales.ts'
+
+const t = makeTranslate(zh, commonZh)
+
+/** The chain share without the optional-`undefined` wrapper (exactOptionalPropertyTypes). */
+type ReasoningChain = NonNullable<AssistantMarkdownProps['renderSlotChain']>
+
+describe('AssistantMarkdown reasoning display chain', () => {
+  it('routes every reasoning block through the chain with positional indices when one is supplied', () => {
+    const owners: ReasoningBlockOwnerProps[] = []
+    // The generic renderSlotChain signature rejects non-generic arrows, so the
+    // stub asserts the share type like the other harnesses in this package.
+    const chain = ((_key: string, owner: ReasoningBlockOwnerProps) => {
+      owners.push(owner)
+      return <div data-chain>{`chain:${owner.reasoningIndex}`}</div>
+    }) as unknown as ReasoningChain
+    const view = render(
+      <AssistantMarkdown
+        t={t}
+        turn={2}
+        step={1}
+        blocks={[
+          { kind: 'reasoning', text: 'first thoughts' },
+          { kind: 'text', text: 'answer body' },
+          { kind: 'reasoning', text: 'second thoughts' },
+        ]}
+        streaming
+        renderSlotChain={chain}
+      />,
+    )
+    expect(owners).toHaveLength(2)
+    expect(owners[0]).toMatchObject({
+      turn: 2, step: 1, reasoningIndex: 0, text: 'first thoughts', running: false,
+    })
+    expect(owners[1]).toMatchObject({
+      turn: 2, step: 1, reasoningIndex: 1, text: 'second thoughts', running: true,
+    })
+    expect(view.getByText('chain:0')).toBeTruthy()
+    expect(view.getByText('chain:1')).toBeTruthy()
+    expect(view.queryByText('Think')).toBeNull()
+  })
+
+  it('falls back to the built-in Think row when the chain declines', () => {
+    const declining = ((_key: string, _owner: object, opts?: { fallback?: React.ReactNode }) =>
+      opts?.fallback ?? null) as unknown as ReasoningChain
+    const view = render(
+      <AssistantMarkdown
+        t={t}
+        turn={1}
+        step={1}
+        blocks={[{ kind: 'reasoning', text: 'declined thoughts' }]}
+        streaming={false}
+        renderSlotChain={declining}
+      />,
+    )
+    expect(view.getByRole('button')).toBeTruthy()
+    expect(view.getByText('declined thoughts')).toBeTruthy()
+  })
+})
